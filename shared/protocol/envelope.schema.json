{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Schoolday development envelope v0",
  "type": "object",
  "required": [
    "version",
    "id",
    "senderId",
    "recipientId",
    "ciphertext",
    "expiresAt"
  ],
  "additionalProperties": false,
  "properties": {
    "version": {
      "const": 0
    },
    "id": {
      "type": "string",
      "minLength": 1
    },
    "senderId": {
      "type": "string",
      "minLength": 1
    },
    "recipientId": {
      "type": "string",
      "minLength": 1
    },
    "ciphertext": {
      "type": "string",
      "minLength": 1
    },
    "expiresAt": {
      "type": "integer",
      "minimum": 1,
      "maximum": 9007199254740991
    }
  }
}

import {test} from 'node:test';import assert from 'node:assert/strict';import {DatabaseSync} from 'node:sqlite';import {readFileSync} from 'node:fs';import {categories,destinations,related,visible,parentId} from '../src/moduleCatalog.ts';const schema=readFileSync(new URL('../../../shared/database/schema.sql',import.meta.url),'utf8');test('consolidated navigation preserves reachable permitted modules',()=>{const roles='Student + Teacher + Parent + School Admin';const roots=categories.flatMap(c=>destinations(c,roles,false));assert.equal(roots.length,22);for(const cat of categories){for(const m of visible(cat,roles,false)){assert.ok(destinations(cat,roles,false).some(r=>r.id===parentId(m.id)));assert.ok(related(cat,roles,false,m.id).some(r=>r.id===m.id));}}assert.ok(!visible('Learn','Student',false).some(r=>r.id==='Gate'));assert.ok(!visible('Learn','Student',true).some(r=>r.id==='Research'));});test('adult relationship does not authorize parental controls or university membership',()=>{const db=new DatabaseSync(':memory:');try{db.exec(schema);db.exec(schema);assert.equal(db.prepare("SELECT count(*) AS n FROM adult_family_demo").get()?.n,2);assert.equal(db.prepare("SELECT count(*) AS n FROM memberships WHERE user_id='child15' AND channel_id='school'").get()?.n,0);assert.equal(db.prepare("SELECT count(*) AS n FROM memberships WHERE user_id='parent' AND channel_id='university'").get()?.n,0);db.exec("INSERT INTO family_links VALUES('parent','university')");assert.throws(()=>db.exec("INSERT INTO quiz_permissions VALUES('university',1,'parent')"));assert.throws(()=>db.exec("INSERT INTO gate_policies VALUES('bad','parent','university',7,30)"));const tok=String(db.prepare("SELECT token FROM identity_tokens WHERE user_id='child15'").get()?.token);assert.throws(()=>db.prepare("INSERT INTO feature_actions VALUES('bad-attendance','teacher','attendance','child15',0,?,?)").run(tok,Date.now()));}finally{db.close()}});

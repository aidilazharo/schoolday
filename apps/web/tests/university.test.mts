import {test} from 'node:test';import assert from 'node:assert/strict';import {DatabaseSync} from 'node:sqlite';import {readFileSync} from 'node:fs';import {visible} from '../src/moduleCatalog.ts';const schema=readFileSync(new URL('../../../shared/database/schema.sql',import.meta.url),'utf8');test('university sample is adult, isolated and migrated once',()=>{const db=new DatabaseSync(':memory:');try{db.exec(schema);assert.equal(db.prepare("SELECT age FROM demographics WHERE user_id='university'").get()?.age,21);assert.deepEqual(db.prepare("SELECT channel_id FROM memberships WHERE user_id='university' ORDER BY channel_id").all().map(r=>r.channel_id),['open','uni-course','university']);assert.throws(()=>db.exec("INSERT INTO wall_posts VALUES('uni-bad','class','university','invalid',1)"));assert.throws(()=>db.exec("INSERT INTO gate_policies VALUES('uni-gate','parent','university',7,30)"));db.exec("UPDATE points_accounts SET balance=90 WHERE user_id='university'");db.exec(schema);assert.equal(db.prepare("SELECT balance FROM points_accounts WHERE user_id='university'").get()?.balance,90);assert.ok(!visible('Learn','Student',false).some(m=>m.id==='Gate'));assert.ok(visible('Learn','Student',true).some(m=>m.id==='Gate'))}finally{db.close()}});

import {test} from 'node:test';import assert from 'node:assert/strict';import {DatabaseSync} from 'node:sqlite';import {readFileSync} from 'node:fs';
const schema=readFileSync(new URL('../../../shared/database/schema.sql',import.meta.url),'utf8');
test('all six accounts contribute both content types and migration is idempotent',()=>{const db=new DatabaseSync(':memory:');try{db.exec(schema);assert.equal(db.prepare('SELECT count(DISTINCT author_id) AS n FROM space_messages').get()?.n,6);assert.equal(db.prepare('SELECT count(DISTINCT author_id) AS n FROM wall_posts').get()?.n,6);const before=db.prepare('SELECT count(*) AS n FROM space_messages').get()?.n;db.exec("UPDATE points_accounts SET balance=70 WHERE user_id='student'");db.exec(schema);assert.equal(db.prepare('SELECT count(*) AS n FROM space_messages').get()?.n,before);assert.equal(db.prepare("SELECT balance FROM points_accounts WHERE user_id='student'").get()?.balance,70);assert.throws(()=>db.exec("INSERT INTO space_messages VALUES('bad','staff','student','no',1)"));db.exec("INSERT INTO drafts VALUES('private','student','open','private',1)");const query="SELECT s.id,s.author_id AS authorId,u.name,COALESCE(n.nickname,'') AS nickname,s.body,s.created_at AS createdAt,0 AS draft FROM space_messages s JOIN users u ON u.id=s.author_id LEFT JOIN user_nicknames n ON n.user_id=u.id JOIN memberships m ON m.channel_id=s.channel_id AND m.user_id=? WHERE s.channel_id=? UNION ALL SELECT d.id,d.user_id,u.name,COALESCE(n.nickname,''),d.body,d.created_at,1 FROM drafts d JOIN users u ON u.id=d.user_id LEFT JOIN user_nicknames n ON n.user_id=u.id JOIN memberships m ON m.user_id=d.user_id AND m.channel_id=d.channel_id WHERE d.user_id=? AND d.channel_id=? ORDER BY createdAt,id";assert.ok(db.prepare(query).all('student','open','student','open').some(r=>r.id==='private'));assert.ok(!db.prepare(query).all('normal','open','normal','open').some(r=>r.id==='private'));assert.equal(db.prepare(query).all('normal','staff','normal','staff').length,0)}finally{db.close()}});

test('sample likes are not restored after unlike',()=>{const db=new DatabaseSync(':memory:');try{db.exec(schema);db.exec("DELETE FROM wall_reactions WHERE post_id='sample-post-4' AND user_id='student'");db.exec(schema);assert.equal(db.prepare("SELECT count(*) AS n FROM wall_reactions WHERE post_id='sample-post-4' AND user_id='student'").get()?.n,0)}finally{db.close()}});

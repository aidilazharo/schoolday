import {test} from 'node:test';import assert from 'node:assert/strict';import {DatabaseSync} from 'node:sqlite';import {readFileSync} from 'node:fs';const schema=readFileSync(new URL('../../../shared/database/schema.sql',import.meta.url),'utf8');test('secondary school group migration is scoped and idempotent',()=>{const db=new DatabaseSync(':memory:');try{db.exec(schema);db.exec(schema);assert.deepEqual(db.prepare("SELECT user_id FROM memberships WHERE channel_id='secondary' ORDER BY user_id").all().map(r=>r.user_id),['child15','dual','parent']);assert.throws(()=>db.exec("INSERT INTO wall_posts VALUES('bad-secondary','secondary','normal','no',1)"));assert.equal(db.prepare("SELECT count(*) AS n FROM wall_posts WHERE id='secondary-welcome'").get()?.n,1);assert.equal(db.prepare("SELECT count(*) AS n FROM memberships WHERE user_id='university'").get()?.n,3)}finally{db.close()}});

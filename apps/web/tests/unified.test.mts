import {test} from 'node:test';import assert from 'node:assert/strict';import {DatabaseSync} from 'node:sqlite';import {readFileSync} from 'node:fs';const schema=readFileSync(new URL('../../../shared/database/schema.sql',import.meta.url),'utf8');
test('shared messages migrate once and support reactions without publishing drafts',()=>{const db=new DatabaseSync(':memory:');try{db.exec(schema);db.exec("INSERT INTO drafts VALUES('private-test','student','open','private',1)");const n=db.prepare("SELECT count(*) AS n FROM wall_posts WHERE id LIKE 'chat:%'").get()?.n;assert.equal(n,db.prepare('SELECT count(*) AS n FROM space_messages').get()?.n);db.exec(schema);assert.equal(db.prepare("SELECT count(*) AS n FROM wall_posts WHERE id LIKE 'chat:%'").get()?.n,n);assert.equal(db.prepare("SELECT count(*) AS n FROM wall_posts WHERE id='chat:private-test'").get()?.n,0);db.exec("INSERT INTO wall_reactions VALUES('chat:sample-chat-0','open','normal')");db.exec("INSERT INTO wall_comments VALUES('unified-test','chat:sample-chat-0','open','normal','reply',1)");assert.throws(()=>db.exec("INSERT INTO wall_reactions VALUES('chat:sample-chat-11','class','normal')"));}finally{db.close()}});

import {test} from 'node:test';import assert from 'node:assert/strict';import {DatabaseSync} from 'node:sqlite';import {readFileSync} from 'node:fs';const schema=readFileSync(new URL('../../../shared/database/schema.sql',import.meta.url),'utf8');
test('family permissions, point conservation, avatar and quiz',()=>{const db=new DatabaseSync(':memory:');try{db.exec(schema);let n=0;const act=(actor:string,kind:string,target='',amount=0,value='')=>db.prepare('INSERT INTO feature_actions VALUES(?,?,?,?,?,?,?)').run(String(++n),actor,kind,target,amount,value,Date.now());const balance=(id:string)=>db.prepare('SELECT balance FROM points_accounts WHERE user_id=?').get(id)?.balance;
assert.equal(balance('child8'),100);assert.throws(()=>act('teacher','transfer','child8',10));act('parent','transfer','child8',20);assert.equal(balance('parent'),80);assert.equal(balance('child8'),120);assert.throws(()=>act('parent','transfer','child8',999));assert.equal(balance('parent'),80);assert.throws(()=>act('child8','buy','',100));act('parent','buy','',100);assert.equal(balance('parent'),180);act('child8','avatar','',0,'star');assert.equal(balance('child8'),110);assert.throws(()=>act('child8','avatar','',0,'star'));assert.throws(()=>act('child8','skip','q8'));assert.throws(()=>act('teacher','permission','child8',1));act('dual','permission','child8',1);act('child8','skip','q8');assert.equal(balance('child8'),105);assert.throws(()=>act('child8','skip','q8'));assert.throws(()=>act('child15','answer','q8',2));act('child15','answer','q15',2);db.exec(schema);assert.equal(balance('child8'),105);
const token=String(db.prepare("SELECT token FROM identity_tokens WHERE user_id='student'").get()?.token);assert.throws(()=>act('normal','attendance','student',0,token));act('teacher','attendance','student',0,token);assert.throws(()=>act('normal','parent','student',0,token));act('parent','friend','student',0,token);act('student','accept','parent');assert.equal(db.prepare("SELECT status FROM identity_requests WHERE actor='parent' AND target='student'").get()?.status,'accepted');
}finally{db.close()}});

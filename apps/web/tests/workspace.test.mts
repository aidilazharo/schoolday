import {test} from 'node:test';import assert from 'node:assert/strict';import {DatabaseSync} from 'node:sqlite';import {readFileSync} from 'node:fs';const schema=readFileSync(new URL('../../../shared/database/schema.sql',import.meta.url),'utf8');test('staff only workspace drafts and idempotent schema',()=>{const db=new DatabaseSync(':memory:');try{db.exec(schema);const add=db.prepare("INSERT INTO workspace_drafts VALUES(?,?,?,?,?,?)");assert.throws(()=>add.run('bad','student','Quiz','Title','Details',1));add.run('q','teacher','Quiz','Math','Question and choices',1);add.run('c','admin','Certificates','Achievement','Recipient',2);add.run('e','dual','Calendar','Event','Date and location',3);db.exec(schema);assert.equal(db.prepare('SELECT count(*) AS n FROM workspace_drafts').get()?.n,3);assert.equal(db.prepare("SELECT count(*) AS n FROM workspace_drafts WHERE owner_id='teacher'").get()?.n,1)}finally{db.close()}});

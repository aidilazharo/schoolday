import {test} from 'node:test';import assert from 'node:assert/strict';import {DatabaseSync} from 'node:sqlite';import {readFileSync} from 'node:fs';const schema=readFileSync(new URL('../../../shared/database/schema.sql',import.meta.url),'utf8');test('quiz unlock policy and grants enforce linked parents and correct answer',()=>{const db=new DatabaseSync(':memory:');try{db.exec(schema);const policy=db.prepare("INSERT INTO gate_policies VALUES(?,?,?,?,?)");const grant=db.prepare("INSERT INTO gate_grants(id,child_id,policy_id,question_id,answer) VALUES(?,?,?,?,?)");assert.throws(()=>policy.run('bad','teacher','student',7,30));assert.throws(()=>policy.run('bad','parent','normal',7,30));assert.throws(()=>policy.run('bad','parent','student',7,999));policy.run('p','parent','student',7,30);assert.throws(()=>grant.run('wrong','student','p','q11',0));assert.throws(()=>grant.run('age','student','p','q8',2));assert.throws(()=>grant.run('skip','student','p','q11',-1));grant.run('ok','student','p','q11',2);assert.equal(db.prepare('SELECT count(*) AS n FROM gate_grants').get()?.n,1);policy.run('p2','dual','student',0,15);assert.throws(()=>grant.run('stale','student','p','q11',2));assert.throws(()=>grant.run('disabled','student','p2','q11',2));db.exec(schema);assert.equal(db.prepare('SELECT count(*) AS n FROM gate_grants').get()?.n,1)}finally{db.close()}});
